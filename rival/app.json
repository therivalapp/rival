{
  "expo": {
    "name": "RIVAL",
    "slug": "rival",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rival",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.therivalapp.rival",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#312927",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131313",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffb59e",
          "sounds": []
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "RIVAL uses your photos to add pictures and videos to your activities.",
          "cameraPermission": "RIVAL uses the camera to take pictures and videos of your activities.",
          "microphonePermission": "RIVAL uses the microphone to record sound with videos of your activities."
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": "production"
        }
      },
      "eas": {
        "projectId": "439cc838-1594-4c3d-ac72-dbf72de24f5f"
      }
    },
    "owner": "therivalapp"
  }
}
